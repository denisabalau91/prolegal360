# Servicio externo de formularios (opcional).
# Sin configurar, los formularios abren el cliente de correo del visitante (mailto:).
#
# Formspree — crea un formulario en https://formspree.io y copia su endpoint:
# NEXT_PUBLIC_FORMS_ENDPOINT=https://formspree.io/f/XXXXXXXX
#
# Web3Forms — crea una access key en https://web3forms.com:
# NEXT_PUBLIC_FORMS_ENDPOINT=https://api.web3forms.com/submit
# NEXT_PUBLIC_FORMS_KEY=tu-access-key

# Subruta cuando el sitio se sirve en GitHub Pages bajo /<repositorio>:
# NEXT_PUBLIC_BASE_PATH=/prolegal

# Verificación opcional de los buscadores mediante metaetiqueta.
# Copia únicamente el valor del atributo content que proporciona cada plataforma.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=token-de-google-search-console
# NEXT_PUBLIC_BING_SITE_VERIFICATION=token-de-bing-webmaster-tools
